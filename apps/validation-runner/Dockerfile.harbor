FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      docker-cli \
      docker-compose \
      git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /runner
COPY apps/validation-runner/requirements-harbor.txt /tmp/harbor-requirements.txt
RUN pip install --no-cache-dir -r /tmp/harbor-requirements.txt

COPY apps/validation-runner/app.py ./app.py
ENV VALIDATION_ARTIFACT_ROOT=/workspace/storage
ENV VALIDATION_IMAGE=code-factory-validation:local
EXPOSE 8011
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8011"]
