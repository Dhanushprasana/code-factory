# Harbor POC - Environment Variables
# Copy this file to .env and fill in your keys

# Required for running harbor with AI agents:
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Agent & model selection for docker compose --profile agent up
# Supported agents: claude-code, openhands, codex-cli, nop, oracle
HARBOR_AGENT=claude-code
# LiteLLM model string
HARBOR_MODEL=anthropic/claude-sonnet-4-5

# Optional cloud sandbox providers:
DAYTONA_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
